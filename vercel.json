{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/cocina", "destination": "/cocina.html" },
    { "source": "/turnos", "destination": "/turnos.html" },
    { "source": "/reportes", "destination": "/reportes.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
